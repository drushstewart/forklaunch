{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Chat",
    "version": "1.0.0"
  },
  "defaultContentType": "application/json",
  "servers": {
    "local": {
      "host": "127.0.0.1:8080",
      "protocol": "ws"
    }
  },
  "channels": {
    "chat": {
      "address": "/chat",
      "bindings": {
        "ws": {
          "method": "GET",
          "bindingVersion": "0.1.0"
        }
      },
      "messages": {
        "request": {
          "$ref": "#/components/messages/Request"
        },
        "reply": {
          "$ref": "#/components/messages/Reply"
        },
        "other": {
          "$ref": "#/components/messages/Other"
        }
      }
    }
  },
  "operations": {
    "accept": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/chat"
      },
      "messages": [
        {
          "$ref": "#/channels/chat/messages/request"
        },
        {
          "$ref": "#/channels/chat/messages/other"
        }
      ]
    },
    "reply": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/chat"
      },
      "messages": [
        {
          "$ref": "#/channels/chat/messages/reply"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "Request": {
        "payload": {
          "$ref": "#/components/schemas/Request"
        }
      },
      "Reply": {
        "payload": {
          "$ref": "#/components/schemas/Reply"
        }
      },
      "Other": {
        "payload": {
          "$ref": "#/components/schemas/Other"
        }
      }
    },
    "schemas": {
      "Request": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "const": "request"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "Reply": {
        "type": "object",
        "required": [
          "kind",
          "accepted"
        ],
        "properties": {
          "kind": {
            "const": "reply"
          },
          "accepted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Other": {
        "type": "object",
        "required": [
          "kind",
          "count"
        ],
        "properties": {
          "kind": {
            "const": "other"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}
