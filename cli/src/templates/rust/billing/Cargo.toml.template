[package]
name = "{{{name}}}"
version.workspace = true
edition.workspace = true
license.workspace = true
authors.workspace = true
description = "{{{description}}}"

[dependencies]
serde_json = "1"
axum = "0.8"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "signal"] }
forklaunch-core = {path = "../../.forklaunch/framework-rs/crates/core", features = ["openapi", "auth", "encryption", "otlp", "postgres", "remote-jwks", "domain", "provider-http"] }
forklaunch-axum = { path = "../../.forklaunch/framework-rs/crates/axum", features = ["remote-jwks", "mcp"] }
forklaunch-billing-interface = { path = "../../.forklaunch/blueprint-rs/crates/interfaces/billing-interface" }
forklaunch-billing-base = { path = "../../.forklaunch/blueprint-rs/crates/implementations/billing/billing-base", features = ["postgres"] }
forklaunch-billing-stripe = { path = "../../.forklaunch/blueprint-rs/crates/implementations/billing/billing-stripe" }
forklaunch-billing-axum = { path = "../../.forklaunch/blueprint-rs/crates/implementations/billing/billing-axum", features = ["bound-checkout"{{#stripe}}, "typescript-routing"{{/stripe}}] }
jsonwebtoken = "9"
sqlx = { version = "0.8", default-features = false, features = ["runtime-tokio", "tls-rustls", "postgres"] }
