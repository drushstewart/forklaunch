# Apply --migrate separately using a schema-owner DATABASE_URL.
DATABASE_URL=postgres://billing_app:CHANGE_ME@127.0.0.1:5432/billing
TENANT_ID=example-tenant
ENCRYPTION_KEY=replace-with-a-high-entropy-field-encryption-key
# LEGACY_ENCRYPTION_KEYS=previous-key
HOST=127.0.0.1
PORT=8000
HMAC_SECRET_KEY=replace-with-a-service-secret
JWKS_PUBLIC_KEY_URL=https://iam.example.com/.well-known/jwks.json
# JWT_ISSUER=https://iam.example.com
# JWT_AUDIENCE=https://billing.example.com
BILLING_DATABASE_BACKUP=false
{{#stripe}}
STRIPE_SECRET_KEY=replace-with-a-secret-provider-key
# Optional direct Stripe callbacks; absent secrets reject incoming deliveries.
# STRIPE_WEBHOOK_SECRET=whsec_replace-me
# Optional managed platform payment-event callbacks.
# INSTANCE_HMAC_KEY=replace-with-the-managed-instance-key
# Optional HTTPS API proxy; explicit loopback HTTP is accepted for fixtures.
# STRIPE_API_BASE=https://api.stripe.com
{{/stripe}}
RUST_LOG=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# MCP shares SERVICE_PORT; set public hosts/origins explicitly behind a proxy.
MCP_ENABLED=true
MCP_PATH=/mcp
# MCP_ALLOWED_HOSTS=api.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com:443
