# Apply --migrate separately using a schema-owner DATABASE_URL.
DATABASE_URL=postgres://messaging_app:CHANGE_ME@127.0.0.1:5432/messaging
TENANT_ID=example-tenant
ENCRYPTION_KEY=replace-with-a-high-entropy-field-encryption-key
# LEGACY_ENCRYPTION_KEYS=previous-key
HOST=127.0.0.1
PORT=8000
HMAC_SECRET_KEY=replace-with-a-service-secret
JWKS_PUBLIC_KEY_URL=https://iam.example.com/.well-known/jwks.json
# JWT_ISSUER=https://iam.example.com
# JWT_AUDIENCE=https://messaging.example.com
{{#twilio}}
TWILIO_ACCOUNT_SID=replace-with-account-sid
TWILIO_AUTH_TOKEN=replace-with-auth-token
TWILIO_FROM_NUMBER=+15550000000
# Must exactly match the externally configured HTTPS callback URL.
TWILIO_STATUS_CALLBACK_URL=https://messaging.example.com/webhook
# Optional HTTPS API proxy; HTTP is permitted only for explicit loopback fixtures.
# TWILIO_API_BASE=https://api.twilio.com/2010-04-01
{{/twilio}}
RUST_LOG=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# MCP shares SERVICE_PORT; set public hosts/origins explicitly behind a proxy.
MCP_ENABLED=true
MCP_PATH=/mcp
# MCP_ALLOWED_HOSTS=api.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com:443

# MCP uses the HTTP listener by default. For a separate listener:
# MCP_LISTENER=separate
# MCP_PORT=10000
# MCP_HOST=127.0.0.1
# Without MCP_PORT, separate mode uses the HTTP port + 2000.
# MCP_PATH=/mcp
# MCP_ENABLED=false
