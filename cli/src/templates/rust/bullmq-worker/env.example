REDIS_URL=redis://localhost:6379/
# Set the platform prefix to match a restricted Redis ACL key/channel namespace.
REDIS_KEY_PREFIX=your-application
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_TYPE=exponential
WORKER_BACKOFF_MS=5000
WORKER_CONCURRENCY=1
WORKER_OPERATION_TIMEOUT_MS=5000
WORKER_HANDLER_TIMEOUT_MS=300000
WORKER_DRAIN_MS=30000
# WORKER_QUEUE=jobs
# WORKER_HTTP_ADDR=127.0.0.1:8081
# WORKER_CONTROL_TOKEN=<generate-a-random-secret-of-at-least-32-characters>
# Optional distributed controls; must have permission for their scoped channels.
# WORKER_SIGNAL_REDIS_URL=redis://localhost:6379/
# WORKER_SIGNAL_NAMESPACE=your-application-production
# TENANT_ID=your-trusted-tenant
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
