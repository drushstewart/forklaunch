[package]
name = "{{{name}}}"
version.workspace = true
edition.workspace = true
license.workspace = true
authors.workspace = true
description = "{{{description}}}"

[dependencies]
{{#uses_framework}}
axum = "0.8"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "signal"] }
forklaunch-axum = { path = "{{{framework_rs_path}}}/crates/forklaunch-axum" }
forklaunch-common = { path = "{{{framework_rs_path}}}/crates/forklaunch-common" }
forklaunch-contract = { path = "{{{framework_rs_path}}}/crates/forklaunch-contract" }
forklaunch-core = { path = "{{{framework_rs_path}}}/crates/forklaunch-core", features = ["otlp"] }
forklaunch-http = { path = "{{{framework_rs_path}}}/crates/forklaunch-http" }
forklaunch-openapi = { path = "{{{framework_rs_path}}}/crates/forklaunch-openapi" }
{{/uses_framework}}
{{#has_binary}}

[dev-dependencies]
tower = { version = "0.5", features = ["util"] }

[[bin]]
name = "{{{name}}}"
path = "src/main.rs"
{{/has_binary}}
