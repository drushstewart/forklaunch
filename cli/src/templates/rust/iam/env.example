# Apply migrations separately with a schema-owner DATABASE_URL and --migrate.
# The running service rejects SUPERUSER and BYPASSRLS connections.
DATABASE_URL=postgres://iam_app:CHANGE_ME@127.0.0.1:5432/iam
TENANT_ID=example-tenant
ENCRYPTION_KEY=replace-with-a-high-entropy-field-encryption-key
# LEGACY_ENCRYPTION_KEYS=previous-key
HMAC_SECRET_KEY=replace-with-a-service-secret
JWKS_PUBLIC_KEY_URL=https://iam.example.com/.well-known/jwks.json
# JWT_ISSUER=https://iam.example.com
# JWT_AUDIENCE=https://iam.example.com
# Optional RS256 session issuance: configure all four values together.
# Supply actual PEM newlines through the deployment secret/environment mechanism.
# Publish the matching public key at the trusted JWKS endpoint used by consumers.
# SESSION_JWT_PRIVATE_KEY_PEM=<RSA private key PEM>
# SESSION_JWT_KEY_ID=iam-session-key-1
# SESSION_JWT_ISSUER=https://iam.example.com
# SESSION_JWT_AUDIENCE=https://api.example.com
# Optional browser sessions: exact trusted HTTPS origin, encrypted PostgreSQL store.
# Apply migrations and grant runtime CRUD on fl_iam_browser_sessions before enabling.
# SESSION_COOKIE_ORIGIN=https://app.example.com
HOST=127.0.0.1
PORT=8000

# Optional OTLP/HTTP export. Omit endpoints for local structured logs only.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20replace-me
# OTEL_SERVICE_NAME=replace-with-service-name
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local
# OTEL_SDK_DISABLED=true

# MCP shares SERVICE_PORT; set public hosts/origins explicitly behind a proxy.
MCP_ENABLED=true
MCP_PATH=/mcp
# MCP_ALLOWED_HOSTS=api.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com:443

# MCP uses the HTTP listener by default. For a separate listener:
# MCP_LISTENER=separate
# MCP_PORT=10000
# MCP_HOST=127.0.0.1
# Without MCP_PORT, separate mode uses the HTTP port + 2000.
# MCP_PATH=/mcp
# MCP_ENABLED=false

# Optional OIDC browser login; requires SESSION_COOKIE_ORIGIN and explicit
# tenant/issuer/subject bindings. Register the exact provider redirect URI:
# https://app.example.com/auth/browser/oidc/callback
# SESSION_OIDC_ISSUER=https://identity.example.com
# SESSION_OIDC_CLIENT_ID=app-client
# SESSION_OIDC_CLIENT_SECRET=server-secret

# Optional directory grants from current linked identities; default jwt-claims.
# Requires SESSION_JWT_* signing and matching trusted JWKS_PUBLIC_KEY_URL.
# Grant SELECT/INSERT/UPDATE/DELETE on fl_iam_directory_identities; provision links explicitly.
# IAM_DIRECTORY_AUTHORIZATION=stored-session
