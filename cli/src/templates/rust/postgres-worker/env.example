DATABASE_URL=postgres://restricted_app:CHANGE_ME@localhost/app
TENANT_ID=your-trusted-tenant
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_SECONDS=30
WORKER_POLL_MS=250
WORKER_LEASE_MS=30000
WORKER_RENEW_MS=10000
WORKER_DRAIN_MS=30000
WORKER_CONCURRENCY=1
# Automatic retention is disabled unless an age is explicitly configured.
# WORKER_COMPLETED_RETENTION_SECONDS=604800
# WORKER_FAILED_RETENTION_SECONDS=2592000
WORKER_RETENTION_INTERVAL_MS=60000
WORKER_RETENTION_BATCH_LIMIT=100
WORKER_RETENTION_TIMEOUT_MS=5000
