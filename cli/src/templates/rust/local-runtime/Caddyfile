https://localhost {
    tls internal
    @auth path @@AUTH_PATHS@@
    handle @auth {
        reverse_proxy @@AUTH@@:3001
    }
    @api path @@API_PATHS@@
    handle @api {
        reverse_proxy @@SERVICE@@:8000 {
            flush_interval -1
        }
    }
    handle /internal/* {
        respond 404
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
