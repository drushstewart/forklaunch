HOST=127.0.0.1
PORT=8000
# Configure the same trusted service secret used by internal HMAC clients.
HMAC_SECRET_KEY=replace-with-a-service-secret
JWKS_PUBLIC_KEY_URL=https://iam.example.com/.well-known/jwks.json
# Optional additional issuer/audience constraints.
# JWT_ISSUER=https://iam.example.com
# JWT_AUDIENCE=https://cac.example.com
RUST_LOG=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
