[package]
name = "{{{name}}}"
version.workspace = true
edition.workspace = true
license.workspace = true
authors.workspace = true
description = "{{{description}}}"

[dependencies]
serde_json = "1"
forklaunch-axum = { path = "../../.forklaunch/framework-rs/crates/forklaunch-axum", features = ["mcp"] }
axum = "0.8"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "net", "signal"] }
forklaunch-core = { path = "../../.forklaunch/framework-rs/crates/forklaunch-core", features = ["otlp"] }
forklaunch-contract = { path = "../../.forklaunch/framework-rs/crates/forklaunch-contract" }
forklaunch-openapi = { path = "../../.forklaunch/framework-rs/crates/forklaunch-openapi" }
forklaunch-auth = { path = "../../.forklaunch/framework-rs/crates/forklaunch-auth", features = ["remote-jwks"] }
forklaunch-cac-interface = { path = "../../.forklaunch/blueprint-rs/crates/interfaces/forklaunch-cac-interface" }
forklaunch-cac-base = { path = "../../.forklaunch/blueprint-rs/crates/implementations/cac/forklaunch-cac-base" }
forklaunch-cac-axum = { path = "../../.forklaunch/blueprint-rs/crates/implementations/cac/forklaunch-cac-axum" }
jsonwebtoken = "9"
