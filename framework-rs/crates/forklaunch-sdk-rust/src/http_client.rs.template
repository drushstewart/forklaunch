/// Ordered multipart form parts; repeated names and file metadata are preserved.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct MultipartResponse {
    pub parts: Vec<MultipartResponsePart>,
}
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
pub struct MultipartResponsePart {
    pub name: String,
    pub file_name: Option<String>,
    pub content_type: Option<String>,
    pub bytes: Vec<u8>,
}
async fn decode_multipart_response(mut response: reqwest::Response, max_bytes: usize) -> Result<MultipartResponse, SdkError> {
    let mime = response.headers().get(reqwest::header::CONTENT_TYPE).and_then(|value| value.to_str().ok())
        .ok_or(SdkError::Multipart("Missing multipart response content type"))?;
    if !mime.split(';').next().unwrap_or_default().trim().eq_ignore_ascii_case("multipart/form-data") {
        return Err(SdkError::Multipart("Expected multipart/form-data response"));
    }
    let boundary = multer::parse_boundary(mime).map_err(|_| SdkError::Multipart("Invalid multipart response boundary"))?;
    let mut bytes = Vec::new();
    while let Some(chunk) = response.chunk().await? {
        if chunk.len() > max_bytes.saturating_sub(bytes.len()) {
            return Err(SdkError::Multipart("Multipart response exceeds byte limit"));
        }
        bytes.extend_from_slice(&chunk);
    }
    let stream = futures_util::stream::once(std::future::ready(Ok::<_, std::io::Error>(bytes)));
    let mut multipart = multer::Multipart::new(stream, boundary);
    let mut parts = Vec::new();
    while let Some(field) = multipart.next_field().await.map_err(|_| SdkError::Multipart("Invalid multipart response"))? {
        if parts.len() >= 1024 { return Err(SdkError::Multipart("Multipart response exceeds part limit")); }
        let name = field.name().ok_or(SdkError::Multipart("Multipart response part has no name"))?.to_owned();
        let file_name = field.file_name().map(str::to_owned);
        let content_type = field.content_type().map(ToString::to_string);
        let bytes = field.bytes().await.map_err(|_| SdkError::Multipart("Invalid multipart response part"))?.to_vec();
        parts.push(MultipartResponsePart { name, file_name, content_type, bytes });
    }
    Ok(MultipartResponse { parts })
}
