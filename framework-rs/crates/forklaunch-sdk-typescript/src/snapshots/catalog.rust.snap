use std::error::Error;
use std::fmt;
use std::sync::Arc;
use std::collections::BTreeMap;

type SdkRequestHook = Arc<dyn Fn(&mut SdkRequest) + Send + Sync>;

use serde::{Deserialize, Serialize};



#[derive(Debug, Clone, PartialEq, Eq)]
pub struct SdkRequest {
    pub method: &'static str,
    pub url: String,
    pub query: BTreeMap<String, String>,
    pub headers: BTreeMap<String, String>,
    pub body: Option<String>,
    pub body_bytes: Option<Vec<u8>>,

    pub content_type: &'static str,
}


fn encode_path_segment(value: &str) -> String {
    const HEX: &[u8; 16] = b"0123456789ABCDEF";
    let mut encoded = String::new();
    for byte in value.bytes() {
        if byte.is_ascii_alphanumeric() || b"-_.!~*'()".contains(&byte) {
            encoded.push(char::from(byte));
        } else {
            encoded.push('%');
            encoded.push(char::from(HEX[usize::from(byte >> 4)]));
            encoded.push(char::from(HEX[usize::from(byte & 15)]));
        }
    }
    encoded
}

fn path_with_params(path: &str, params: &BTreeMap<String, String>) -> String {
    path.split('/')
        .map(|segment| {
            let name = segment.strip_prefix(':').or_else(|| {
                segment.strip_prefix('{').and_then(|name| name.strip_suffix('}'))
            });
            name.and_then(|name| params.get(name))
                .map_or_else(|| segment.to_owned(), |value| encode_path_segment(value))
        })
        .collect::<Vec<_>>()
        .join("/")
}



#[derive(Debug)]
pub enum SdkError {
    Transport(reqwest::Error),

}

impl fmt::Display for SdkError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Self::Transport(error) => write!(formatter, "{error}"),

        }
    }
}

impl Error for SdkError {
    fn source(&self) -> Option<&(dyn Error + 'static)> {
        match self {
            Self::Transport(error) => Some(error),

        }
    }
}

impl From<reqwest::Error> for SdkError {
    fn from(error: reqwest::Error) -> Self {
        Self::Transport(error)
    }
}



#[derive(Clone)]
pub enum SdkAuth {
    Bearer(String),
    Basic { username: String, password: String },
    HmacHeader { header_name: String, value: String },
}


fn deserialize_optional_field<'de, D, T>(deserializer: D) -> Result<Option<T>, D::Error>
where D: serde::Deserializer<'de>, T: Deserialize<'de>,
{
    T::deserialize(deserializer).map(Some)
}


fn deserialize_required_field<'de, D, T>(deserializer: D) -> Result<T, D::Error>
where D: serde::Deserializer<'de>, T: Deserialize<'de>,
{
    T::deserialize(deserializer)
}





#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
#[serde(deny_unknown_fields)]
pub struct CreateItemResponse {

    #[serde(deserialize_with = "deserialize_required_field")]
    #[serde(rename = "id")]
    pub id: String,

    #[serde(deserialize_with = "deserialize_required_field")]
    #[serde(rename = "name")]
    pub name: String,

    #[serde(default, deserialize_with = "deserialize_optional_field", skip_serializing_if = "Option::is_none")]
    #[serde(rename = "note")]
    pub note: Option<Option<String>>,

    #[serde(default, deserialize_with = "deserialize_optional_field", skip_serializing_if = "Option::is_none")]
    #[serde(rename = "tags")]
    pub tags: Option<Vec<String>>,

}





