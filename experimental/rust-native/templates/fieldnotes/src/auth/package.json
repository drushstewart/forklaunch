{
  "name": "fieldnotes-auth",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc --noEmit false && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __test__/*.test.ts",
    "migrate:up": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "express": "5.1.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "ws": "8.22.0"
  }
}
